---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="wrap nf">
    <h1 class="display h1">This one's sold out</h1>
    <p class="lede">We couldn't find that page. Today's bakes are on the home page, and the full menu is a click away.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Today's bakes</a>
      <a class="btn btn-quiet" href="/menu">See the menu</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: 120px 160px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
